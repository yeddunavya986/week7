        "from google.colab import userdata\n",
        "from groq import Groq\n"
      ],
      "metadata": {
        "id": "9RgIB8Cx9zi3"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "api_key = userdata.get(\"GROQ_API_KEY\")\n",
        "client = Groq(api_key=api_key)\n"
      ],
      "metadata": {
        "id": "gBCA00Yh93sG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ---------------------------------------\n",
        "# Article\n",
        "# ---------------------------------------\n",
        "\n",
        "article = \"\"\"\n",
        "Artificial Intelligence (AI) is a technology that allows computers to perform tasks\n",
        "that normally require human intelligence. AI is used in healthcare, education,\n",
        "banking, transportation, and many other fields. It helps improve accuracy,\n",
        "save time, and automate repetitive tasks. As AI continues to develop,\n",
        "it is becoming an important part of our daily lives.\n",
        "\"\"\"\n",
        "\n",
        "# ---------------------------------------\n",
        "# Basic Prompt\n",
        "# ---------------------------------------\n",
        "\n",
        "basic_prompt = f\"\"\"\n",
        "Summarize the following article:\n",
        "\n",
        "{article}\n",
        "\"\"\"\n",
        "\n",
        "basic_response = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[{\"role\": \"user\", \"content\": basic_prompt}]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Refinement Cycle 1\n",
        "# ---------------------------------------\n",
        "\n",
        "refinement1 = f\"\"\"\n",
        "Summarize the following article.\n",
        "\n",
        "Write in about 50 words.\n",
        "Use simple English.\n",
        "\n",
        "Article:\n",
        "{article}\n",
        "\"\"\"\n",
        "\n",
        "response1 = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[{\"role\": \"user\", \"content\": refinement1}]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Refinement Cycle 2\n",
        "# ---------------------------------------\n",
        "\n",
        "refinement2 = f\"\"\"\n",
        "Summarize the following article.\n",
        "\n",
        "Rules:\n",
        "- Write 40 to 50 words.\n",
        "- Use simple English.\n",
        "- Write exactly 4 bullet points.\n",
        "\n",
        "Article:\n",
        "{article}\n",
        "\"\"\"\n",
        "\n",
        "response2 = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[{\"role\": \"user\", \"content\": refinement2}]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Display Results\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"========== Basic Prompt ==========\\n\")\n",
        "print(basic_prompt)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(basic_response.choices[0].message.content)\n",
        "\n",
        "print(\"\\n\\n========== Refinement Cycle 1 ==========\\n\")\n",
        "print(refinement1)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(response1.choices[0].message.content)\n",
        "\n",
        "print(\"\\n\\n========== Refinement Cycle 2 ==========\\n\")\n",
        "print(refinement2)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(response2.choices[0].message.content)\n"
      ],
